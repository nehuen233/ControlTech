# Puerto del servidor Express
PORT=4000

# Conexion MySQL (base creada con "BD CONTROLTECH.sql").
# XAMPP / instalacion por defecto: usuario root con contrasena vacia.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Nombre de la base: "controltecchh" segun BD CONTROLTECH.sql
# (si la creaste con otro nombre, por ejemplo "controltech", ponelo aca)
DB_NAME=controltecchh

# Clave para firmar los tokens de sesion (cambiar por una cadena larga y aleatoria)
JWT_SECRET=cambiar-esta-clave
JWT_EXPIRES_IN=8h

# Origen permitido del frontend React
CORS_ORIGIN=http://localhost:5173

# Alertas de mantenimiento: dias sin preventivo para alertar y cada cuantos minutos se verifica
ALERTA_PREVENTIVO_DIAS=180
ALERTAS_INTERVALO_MIN=15

# ---------- Multi-institución ----------
# Nombre de la institución a la que se asignan los datos que ya existían al migrar una base
# anterior (migración 003). En una instalación nueva no se usa.
INSTITUCION_INICIAL_NOMBRE=Institución principal
# Superadministrador de la plataforma: da de alta y suspende instituciones. Se crea al iniciar
# el backend si no existe (la contraseña debe tener al menos 8 caracteres). Las pruebas lo usan.
SUPERADMIN_EMAIL=superadmin@controltech.local
SUPERADMIN_PASSWORD=cambiar-esta-clave-superadmin
# Opcional: administrador de la institución "Demo" que crea "npm run db:demo". Si no se indica,
# se genera una contraseña y se muestra una sola vez en la consola.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
